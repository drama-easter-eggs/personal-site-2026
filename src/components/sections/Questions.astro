---
import { site, lenses } from "../../data/site";
---

<section id="questions" class="section band-warm questions">
  <div class="shell">
    <header class="questions__head">
      <p class="eyebrow" data-reveal>07 — Questions I Explore</p>
      <h2 class="h1 zh questions__title" data-reveal style="--reveal-delay:60ms">我的觀點</h2>
      <p class="lead questions__intro" data-reveal style="--reveal-delay:120ms">
        即使沒有客戶委託，我仍然會持續追問的問題。目前主要透過三個角度觀看。
      </p>
    </header>

    <ul class="lenses">
      {lenses.map((lens, i) => (
        <li class="lens" data-reveal style={`--reveal-delay:${i * 90}ms`}>
          <p class="lens__name">{lens.name}</p>
          <p class="lens__pair">{lens.pair}</p>
          <h3 class="h3 zh lens__question">{lens.question}</h3>
          <p class="lens__scope">{lens.scope}</p>
        </li>
      ))}
    </ul>

    <div class="subscribe" data-reveal>
      <div class="subscribe__text">
        <h3 class="h3 zh subscribe__title">這些探索，我會寫在電子報裡</h3>
        <p class="subscribe__body">訂閱後，新的觀察與整理會直接寄到你的信箱。</p>
      </div>
      {site.substackUrl ? (
        <a class="pill pill--solid" href={site.substackUrl} target="_blank" rel="noopener">
          訂閱電子報
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      ) : (
        /* TODO: 在 src/data/site.ts 填入 substackUrl 後，這裡會變成可點的訂閱按鈕 */
        <span class="pill pill--ghost subscribe__pending">電子報連結待補</span>
      )}
    </div>
  </div>
</section>

<style>
  .questions__head { display: grid; gap: 16px; padding-bottom: clamp(44px, 5.5vw, 72px); }
  .questions__intro { max-width: 44ch; }

  .lenses {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid #dedbd4;
  }
  .lens {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: clamp(28px, 3.5vw, 40px) clamp(20px, 2.6vw, 32px);
    border-bottom: 1px solid #dedbd4;
  }
  .lens + .lens { border-left: 1px solid #dedbd4; }
  .lens:first-child { padding-left: 0; }
  .lens:last-child { padding-right: 0; }

  .lens__name {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--color-ink);
  }
  .lens__pair {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ash);
  }
  .lens__question { margin-top: 6px; color: var(--color-ink); }
  .lens__scope {
    font-size: 0.875rem;
    line-height: 1.9;
    letter-spacing: 0.04em;
    color: var(--color-ash);
  }

  .subscribe {
    margin-top: clamp(44px, 5.5vw, 68px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: clamp(20px, 3vw, 40px);
    padding: clamp(28px, 3.5vw, 40px);
    background: var(--color-paper);
    border: 1px solid #dedbd4;
    border-radius: var(--radius-card);
  }
  .subscribe__text { display: grid; gap: 8px; }
  .subscribe__title { color: var(--color-ink); }
  .subscribe__body {
    font-size: 0.9375rem;
    line-height: 1.85;
    letter-spacing: 0.04em;
    color: var(--color-ash);
  }
  .subscribe__pending { opacity: .45; cursor: default; }
  .subscribe__pending:hover { background: transparent; color: var(--color-ink); }

  @media (max-width: 860px) {
    .lenses { grid-template-columns: 1fr; }
    .lens { padding-inline: 0; }
    .lens + .lens { border-left: 0; }
  }
</style>
