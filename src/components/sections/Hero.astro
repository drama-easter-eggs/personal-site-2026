---
import { site } from "../../data/site";
---

<section id="hero" class="hero">
  <div class="shell hero__grid">
    <div class="hero__text">
      <p class="eyebrow" data-reveal>Independent Researcher · Experience Strategy</p>

      <h1 class="display zh hero__headline" data-reveal style="--reveal-delay:80ms">
        Hi，我是 Mei，<br />
        我是一位獨立研究者／體驗策略顧問。
      </h1>

      <div class="prose-zh hero__body" data-reveal style="--reveal-delay:160ms">
        <p>
          我持續透過實際觀察、研究，理解人們真正重視什麼、實際如何行動，以及分析那些看似矛盾的行為模式。
        </p>
        <p>
          協助產品、服務團隊在複雜模糊的探索階段，找到真正值得投入的方向。
        </p>
      </div>

      <div class="hero__actions" data-reveal style="--reveal-delay:240ms">
        <a href="#contact" class="pill pill--solid">
          聊聊你的問題
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a href="#work" class="pill pill--ghost">看精選案例</a>
      </div>
    </div>

    <figure class="hero__portrait" data-reveal style="--reveal-delay:200ms">
      <!-- 把你的照片放到 public/portrait.jpg 就會自動替換掉下方的預設版面 -->
      <img
        id="portrait"
        src="/portrait.jpg"
        alt="Mei 的照片"
        loading="eager"
        decoding="async"
        onerror="this.remove()"
      />
      <div class="hero__portrait-fallback" aria-hidden="true">
        <span class="hero__portrait-mark">M</span>
        <span class="caption">portrait</span>
      </div>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(56px, 8vw, 104px) clamp(72px, 10vw, 128px);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.38fr) minmax(0, 0.62fr);
    gap: clamp(40px, 6vw, 72px);
    align-items: center;
  }

  .hero__headline {
    margin-top: 22px;
  }

  .hero__body {
    margin-top: 30px;
    max-width: 48ch;
  }

  .hero__actions {
    margin-top: 38px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Portrait sits in a warm vitrine — hairline frame, no shadow. */
  .hero__portrait {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-paper-warm);
    border: 1px solid var(--color-rule);
  }
  .hero__portrait img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero__portrait-fallback {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background:
      radial-gradient(120% 90% at 50% 0%, #ffffff 0%, var(--color-paper-warm) 55%, #efece6 100%);
  }
  .hero__portrait-mark {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(4rem, 9vw, 7rem);
    line-height: 1;
    color: #d8d4cc;
  }

  @media (max-width: 860px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .hero__portrait {
      order: -1;
      aspect-ratio: 3 / 2;
      max-height: 320px;
    }
    .hero__body { max-width: none; }
  }
</style>
