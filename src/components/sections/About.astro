---
import { stats, experience, industries, teaching, talks } from "../../data/site";

// Talks are placeholders in website-plan.md — only render rows that are filled in.
const filledTalks = talks.filter((t) => t.title.trim().length > 0);
---

<section id="about" class="section about">
  <div class="shell">
    <header class="about__head">
      <p class="eyebrow" data-reveal>04 — About Me</p>
      <h2 class="h1 zh about__title" data-reveal style="--reveal-delay:60ms">我的經歷</h2>
      <p class="lead about__kicker" data-reveal style="--reveal-delay:120ms">研究、教學、公開分享</p>
    </header>

    <!-- Stat strip: three columns divided by hairline rules. The number is part
         of the sentence, not a hero figure. -->
    <ul class="stats" data-reveal>
      {stats.map((s) => (
        <li class="stat">
          <p class="stat__value">
            <span class="stat__num" data-count-to={s.value}>0</span><span
              class="stat__suffix">{s.suffix}</span>
          </p>
          <p class="stat__label">{s.label}</p>
        </li>
      ))}
    </ul>

    <!-- 工作經驗 -->
    <div class="about__block">
      <h3 class="about__label" data-reveal>工作經驗</h3>
      <ol class="timeline">
        {experience.map((job, i) => (
          <li class="timeline__item" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <p class="timeline__period">{job.period}</p>
            <div class="timeline__text">
              <h4 class="h3 zh timeline__role">{job.role}</h4>
              <p class="timeline__body">{job.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="industries" data-reveal>
        <p class="caption industries__label">曾涉略以下領域</p>
        <ul class="industries__list">
          {industries.map((n) => <li class="tag">{n}</li>)}
        </ul>
      </div>

      <div class="prose-zh about__reflection" data-reveal>
        <p>
          多年的跨產業研究之後，我發現讓我真正感興趣的並非在同個產業中深度鑽研，而是跨入不同領域當中，快速進到陌生情境裡，找到人們真正重視、卻不一定說得清楚的那些事情。
        </p>
        <p>而個人有個癖好就是，在跨領域的產業中，看見共同的人性需求。</p>
      </div>
    </div>

    <!-- 教學經驗 -->
    <div class="about__block">
      <blockquote class="pullquote" data-reveal>
        <p class="h3 zh">
          除了研究與顧問，我也透過演講、工作坊與教學，把研究過程中累積的方法與觀察整理出來，和不同領域的人一起交流
        </p>
      </blockquote>

      <h3 class="about__label" data-reveal>教學經驗</h3>
      <ul class="teach">
        {teaching.map((t, i) => (
          <li class="teach__item" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <span class="teach__no">{t.no}</span>
            <h4 class="teach__title zh">{t.title}</h4>
            <p class="teach__body">{t.body}</p>
          </li>
        ))}
      </ul>

      {filledTalks.length > 0 && (
        <div class="talks">
          <h3 class="about__label" data-reveal>Selected Talks &amp; Slides</h3>
          <ul class="talks__list">
            {filledTalks.map((t, i) => (
              <li class="talks__item" data-reveal style={`--reveal-delay:${i * 70}ms`}>
                <div class="talks__main">
                  <h4 class="talks__title zh">{t.title}</h4>
                  <p class="talks__note">{t.note}</p>
                </div>
                <p class="talks__venue">{t.venue}</p>
                {t.slidesUrl && (
                  <a class="talks__link" href={t.slidesUrl} target="_blank" rel="noopener">
                    View slides <span class="arrow" aria-hidden="true">→</span>
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .about__head { display: grid; gap: 16px; padding-bottom: clamp(40px, 5vw, 64px); }
  .about__kicker { letter-spacing: 0.1em; }

  /* --- Stat strip --- */
  .stats {
    list-style: none;
    margin: 0;
    padding: clamp(32px, 4vw, 44px) 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--color-rule);
  }
  .stat { padding-inline: clamp(0px, 3vw, 32px); }
  .stat + .stat { border-left: 1px solid var(--color-rule); }
  .stat:first-child { padding-left: 0; }

  .stat__value {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.25rem, 4.4vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: 0.01em;
    color: var(--color-ink);
  }
  .stat__suffix { font-size: 0.5em; letter-spacing: 0.04em; padding-left: 2px; }
  .stat__label {
    margin-top: 10px;
    font-size: 0.8125rem;
    line-height: 1.7;
    letter-spacing: 0.06em;
    color: var(--color-ash);
  }

  /* --- Shared block scaffolding --- */
  .about__block { padding-top: clamp(56px, 7vw, 96px); }
  .about__label {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ash);
    padding-bottom: 24px;
  }

  /* --- Timeline --- */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-rule);
  }
  .timeline__item {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    gap: clamp(16px, 3vw, 40px);
    padding-block: clamp(24px, 3vw, 34px);
    border-bottom: 1px solid var(--color-rule);
  }
  .timeline__period {
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    color: var(--color-ash);
    padding-top: 6px;
  }
  .timeline__text { display: grid; gap: 10px; max-width: 56ch; }
  .timeline__role { color: var(--color-ink); }
  .timeline__body {
    font-size: 0.9375rem;
    line-height: 1.9;
    letter-spacing: 0.04em;
    color: var(--color-ash);
  }

  /* --- Industries --- */
  .industries {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    gap: clamp(16px, 3vw, 40px);
    align-items: start;
    padding-block: clamp(24px, 3vw, 32px);
    border-bottom: 1px solid var(--color-rule);
  }
  .industries__label { padding-top: 4px; }
  .industries__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
  }

  .about__reflection { margin-top: clamp(32px, 4vw, 44px); max-width: 52ch; }

  /* --- Pull quote --- */
  .pullquote {
    margin: 0 0 clamp(48px, 6vw, 72px);
    padding: clamp(28px, 3.5vw, 40px) clamp(24px, 3.5vw, 44px);
    background: var(--color-paper-warm);
    border-radius: var(--radius-card);
    max-width: 60ch;
  }
  .pullquote p { color: var(--color-ink); }

  /* --- Teaching --- */
  .teach {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 2.5vw, 32px);
    border-top: 1px solid var(--color-rule);
    padding-top: clamp(28px, 3.5vw, 40px);
  }
  .teach__item { display: grid; gap: 12px; align-content: start; }
  .teach__no {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-ash);
  }
  .teach__title {
    font-size: clamp(1.0625rem, 1.6vw, 1.1875rem);
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: 0.04em;
    color: var(--color-ink);
  }
  .teach__body {
    font-size: 0.9375rem;
    line-height: 1.9;
    letter-spacing: 0.04em;
    color: var(--color-ash);
  }

  /* --- Talks --- */
  .talks { padding-top: clamp(56px, 7vw, 88px); }
  .talks__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-rule); }
  .talks__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 200px auto;
    gap: clamp(12px, 3vw, 32px);
    align-items: baseline;
    padding-block: clamp(22px, 2.6vw, 30px);
    border-bottom: 1px solid var(--color-rule);
  }
  .talks__main { display: grid; gap: 8px; }
  .talks__title {
    font-size: clamp(1.0625rem, 1.6vw, 1.1875rem);
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: 0.04em;
  }
  .talks__note, .talks__venue {
    font-size: 0.875rem;
    line-height: 1.8;
    letter-spacing: 0.05em;
    color: var(--color-ash);
  }
  .talks__link {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
    display: inline-flex;
    gap: 6px;
  }
  .talks__link .arrow { transition: transform .25s ease; }
  .talks__link:hover .arrow { transform: translateX(3px); }

  @media (max-width: 820px) {
    .teach { grid-template-columns: 1fr; gap: 28px; }
    .talks__item { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .stats { grid-template-columns: 1fr; gap: 28px; }
    .stat + .stat { border-left: 0; border-top: 1px solid var(--color-rule); padding-top: 28px; }
    .stat { padding-inline: 0; }
    .timeline__item, .industries { grid-template-columns: 1fr; gap: 12px; }
  }
</style>

<script>
  // Count up once, when the stat strip first enters view.
  const nums = document.querySelectorAll<HTMLElement>("[data-count-to]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const render = (el: HTMLElement, v: number) => {
    el.textContent = String(v);
  };

  if (reduced) {
    nums.forEach((el) => render(el, Number(el.dataset.countTo)));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          io.unobserve(el);

          const target = Number(el.dataset.countTo);
          const duration = 1100;
          const start = performance.now();

          const tick = (now: number) => {
            const t = Math.min((now - start) / duration, 1);
            // easeOutExpo — fast out of the gate, settles on the number
            const eased = t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
            render(el, Math.round(target * eased));
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      },
      { threshold: 0.5 },
    );
    nums.forEach((el) => io.observe(el));
  }
</script>
