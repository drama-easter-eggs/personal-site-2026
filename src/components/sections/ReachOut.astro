---
import { reachOutFit, reachOutNotFit } from "../../data/site";
---

<!-- The one inverted plate on the page. This is the decision moment, so the
     contrast reads as a deliberate pause in the editorial rhythm. -->
<section id="reach" class="section band-ink reach">
  <div class="shell">
    <header class="reach__head">
      <p class="eyebrow" data-reveal>05 — When to reach out</p>
      <h2 class="h1 zh reach__title" data-reveal style="--reveal-delay:60ms">什麼情況適合找我</h2>
      <p class="lead reach__intro" data-reveal style="--reveal-delay:120ms">
        如果你正遇到這些情境，很適合找我先一起聊聊：
      </p>
    </header>

    <ul class="reach__list">
      {reachOutFit.map((item, i) => (
        <li class="reach__item" data-reveal style={`--reveal-delay:${i * 55}ms`}>
          <span class="reach__mark" aria-hidden="true"></span>
          <span>{item}</span>
        </li>
      ))}
    </ul>

    <div class="reach__not" data-reveal>
      <h3 class="reach__not-title zh">這些可能比較不適合找我</h3>
      <ul class="reach__not-list">
        {reachOutNotFit.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .reach__head { display: grid; gap: 16px; padding-bottom: clamp(40px, 5vw, 60px); }
  .reach__title { color: var(--color-paper); }
  .reach__intro { color: var(--color-ash-inv); max-width: 46ch; }

  .reach__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(24px, 5vw, 64px);
    border-top: 1px solid var(--color-rule-ink);
  }
  .reach__item {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    padding-block: clamp(18px, 2.2vw, 24px);
    border-bottom: 1px solid var(--color-rule-ink);
    font-size: clamp(0.9375rem, 1.4vw, 1.0625rem);
    line-height: 1.8;
    letter-spacing: 0.04em;
    color: var(--color-paper);
  }
  /* 7 items in 2 columns leaves a stranded rule — let the last one span. */
  .reach__item:last-child:nth-child(odd) { grid-column: 1 / -1; }

  /* Hairline plus-mark instead of an icon set — keeps the page icon-free. */
  .reach__mark {
    position: relative;
    width: 11px;
    height: 11px;
    margin-top: 0.62em;
  }
  .reach__mark::before,
  .reach__mark::after {
    content: "";
    position: absolute;
    background: var(--color-ash-inv);
  }
  .reach__mark::before { inset: 5px 0 5px 0; height: 1px; }
  .reach__mark::after { inset: 0 5px 0 5px; width: 1px; }

  .reach__not {
    margin-top: clamp(48px, 6vw, 72px);
    padding: clamp(28px, 3.5vw, 40px);
    border: 1px solid var(--color-rule-ink);
    border-radius: var(--radius-card);
    max-width: 60ch;
  }
  .reach__not-title {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--color-paper);
    padding-bottom: 18px;
  }
  .reach__not-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .reach__not-list li {
    position: relative;
    padding-left: 20px;
    font-size: 0.9375rem;
    line-height: 1.85;
    letter-spacing: 0.04em;
    color: var(--color-ash-inv);
  }
  .reach__not-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.88em;
    width: 9px;
    height: 1px;
    background: var(--color-ash-inv);
  }

  @media (max-width: 780px) {
    .reach__list { grid-template-columns: 1fr; }
  }
</style>
