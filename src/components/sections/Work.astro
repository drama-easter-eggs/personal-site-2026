---
import { works } from "../../data/site";
---

<section id="work" class="section band-warm work">
  <div class="shell">
    <header class="work__head">
      <div>
        <p class="eyebrow" data-reveal>03 — Selected Work</p>
        <h2 class="h1 zh work__title" data-reveal style="--reveal-delay:60ms">精選案例故事</h2>
      </div>
      <p class="prose-zh work__intro" data-reveal style="--reveal-delay:120ms">
        很多看似理性的市場行為，背後其實都有感受在運作。不論是什麼樣的產品或服務，背後都有一些打動人心的隱藏力量，我相信，唯有當我們抱持著真實想靠近理解的心情，才能真正看清楚中間的結構脈絡。
      </p>
    </header>

    <ul class="work__grid">
      {works.map((w, i) => (
        <li class="card work__card" data-reveal style={`--reveal-delay:${(i % 2) * 90}ms`}>
          <span class="work__no">{w.no}</span>
          <h3 class="h3 zh work__card-title">{w.title}</h3>
          <div class="work__lines">
            {w.lines.map((line) => <p>{line}</p>)}
          </div>
          <ul class="work__tags">
            {w.tags.map((tag) => <li class="tag">{tag}</li>)}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .work__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: end;
    padding-bottom: clamp(44px, 5.5vw, 72px);
  }
  .work__title { margin-top: 18px; }
  .work__intro { max-width: 48ch; }

  .work__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 24px);
  }

  .work__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: border-color .3s ease, transform .3s ease;
  }
  .work__card:hover {
    border-color: var(--color-ink);
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .work__card { transition: none; }
  }

  .work__no {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.9375rem;
    letter-spacing: 0.1em;
    color: var(--color-ash);
  }
  .work__card-title { color: var(--color-ink); }

  .work__lines {
    display: grid;
    gap: 12px;
    font-size: 0.9375rem;
    line-height: 1.9;
    letter-spacing: 0.04em;
    color: var(--color-ash);
    flex: 1;
  }

  .work__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 4px 0 0;
    padding: 0;
  }

  @media (max-width: 820px) {
    .work__head { grid-template-columns: 1fr; align-items: start; }
    .work__grid { grid-template-columns: 1fr; }
  }
</style>
